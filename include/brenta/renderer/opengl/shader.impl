template <typename... Args>
std::optional<Shader>
Shader::create(const Shader::Name &shader_name,
               Shader::Type type, const char* src,
               Args... args)
{
  std::vector<Shader::Id> compiled_shaders = {};
  if (!compile_shaders(compiled_shaders, type, src, args...))
  {
    ERROR("shader: error compiling shader {}", shader_name);
    return {};
  }

  std::optional<Shader::Id> id =
    Shader::link_program(compiled_shaders, nullptr, 0);
  if (!id) return {};
  
  Shader::clean_compilation(compiled_shaders);
  Shader::shaders.insert({shader_name, *id});
  return Shader(*id, shader_name);
}

template <typename... Args>
std::optional<Shader>
Shader::create(const GLchar **feedback_varyings, int num_varyings,
               const Shader::Name &shader_name,
               Shader::Type type, const char* src,
               Args... args)
{
  std::vector<Shader::Id> compiled_shaders = {};
  if (!compile_shaders(compiled_shaders, type, src, args...))
  {
    ERROR("shader: error compiling shader {}", shader_name);
    return {};
  }

  std::optional<Shader::Id> id =
    Shader::link_program(compiled_shaders, feedback_varyings, num_varyings);
  if (!id) return {};
  
  Shader::clean_compilation(compiled_shaders);
  Shader::shaders.insert({shader_name, *id});
  return Shader(*id, shader_name);
}

template <typename... Args>
std::optional<Shader>
Shader::create(const Shader::Name &shader_name,
               Shader::Type type, const std::filesystem::path &path,
               Args... args)
{
  auto code = Shader::read_file(path);
  if (!code) return {};
  return Shader::create(shader_name, type, (*code).c_str(), args...);
}

template <typename... Args>
std::optional<Shader>
Shader::create(const GLchar **feedback_varyings, int num_varyings,
               const Shader::Name &shader_name,
               Shader::Type type, const std::filesystem::path &path,
               Args... args)
{
  auto code = Shader::read_file(path);
  if (!code) return {};
  return Shader::create(feedback_varyings, num_varyings,
                        shader_name, type, (*code).c_str(), args...);
}

template <typename... Args>
bool Shader::compile_shaders(std::vector<Shader::Id> &compiled,
                             Shader::Type type, const char* src,
                             Args... args)
{
  GLenum shader_type_gl;
  switch(type)
  {
  case Fragment:  shader_type_gl  = GL_FRAGMENT_SHADER; break;
  case Vertex:    shader_type_gl  = GL_VERTEX_SHADER; break;
  case Geometry:  shader_type_gl  = GL_GEOMETRY_SHADER; break;
  case Compute:   shader_type_gl  = GL_COMPUTE_SHADER; break;
  default:        shader_type_gl  = 0; break;
  }
    
  unsigned int shader = glCreateShader(shader_type_gl);
  glShaderSource(shader, 1, &src, NULL);
  glCompileShader(shader);
  if (!Shader::check_compile_errors(shader))
  {
    return false;
  }

  compiled.push_back(shader);
  return compile_shaders(compiled, args...);
}

template <typename... Args>
bool Shader::compile_shaders(std::vector<Shader::Id> &compiled,
                             Shader::Type type, const std::filesystem::path& path,
                             Args... args)
{
  auto code = Shader::read_file(path);
  if (!code) return false;
  return compile_shaders(compiled, type, (*code).c_str(), args...);  
}
